{
  "name": "@artpumpkin/mpv-player",
  "version": "0.1.1",
  "description": "Frontend bindings + React UI for tauri-plugin-mpv-player (embedded libmpv video player).",
  "type": "module",
  "license": "MIT",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "types": "./dist-js/index.d.ts",
      "import": "./dist-js/index.js",
      "require": "./dist-js/index.cjs"
    },
    "./react": {
      "types": "./dist-js/react/index.d.ts",
      "import": "./dist-js/react/index.js",
      "require": "./dist-js/react/index.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist-js",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "rollup -c"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "peerDependencies": {
    "clsx": ">=2",
    "lucide-react": ">=1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rollup": "^4.63.4",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
